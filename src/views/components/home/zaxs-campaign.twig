{# ZAXS homepage — bundled look images so the design shows on any store. #}
{% set z_hero_kicker = theme.settings.get('zaxs_hero_kicker', 'NEW DROP') %}
{% set z_hero_title = theme.settings.get('zaxs_hero_title', 'أكثر من مجرد هودي.') %}
{% set z_hero_sub = theme.settings.get('zaxs_hero_sub', 'ستايلك في الشارع. من القهوة.. لآخر طلعة.') %}
{% set z_hero_cta = theme.settings.get('zaxs_hero_cta', 'تسوق المجموعة') %}
{% set z_hero_cta2 = theme.settings.get('zaxs_hero_cta2', 'قصتنا') %}
{% set z_hero_desk = theme.settings.get('zaxs_hero_desktop') %}
{% set z_life = theme.settings.get('zaxs_lifestyle') %}
{% set z_story_img = theme.settings.get('zaxs_story_image') %}
{% set img_hero = z_hero_desk ? z_hero_desk : ('images/zaxs/catalog/hero.jpg'|asset) %}
{% set img_statement = z_story_img ? z_story_img : ('images/zaxs/look-back.jpg'|asset) %}
{% set img_focus = 'images/zaxs/hoodie-olive.jpg'|asset %}
{% set img_life = z_life ? z_life : ('images/zaxs/lifestyle-city.jpg'|asset) %}
{% set img_story = z_story_img ? z_story_img : ('images/zaxs/catalog/story.jpg'|asset) %}
{% set back = 'images/zaxs/hoodie-olive-back.jpg'|asset %}
{% set shop = store.url %}

<section class="zaxs-hero" data-testid="store-home-zaxs-campaign" data-hero>
  <div class="zaxs-hero__media" data-hero-slides>
    <img class="is-on" src="{{ img_hero }}" alt="ZAXS" width="1920" height="1080" fetchpriority="high">
    <img src="{{ 'images/zaxs/catalog/zip-olive.jpg'|asset }}" alt="" width="1920" height="1080">
    <img src="{{ 'images/zaxs/catalog/hoodie-burgundy.jpg'|asset }}" alt="" width="1920" height="1080">
    <img src="{{ 'images/zaxs/catalog/half-green.jpg'|asset }}" alt="" width="1920" height="1080">
  </div>
  <div class="zaxs-hero__copy">
    <img class="zaxs-hero__mark" src="{{ 'images/zaxs/zaxs-mark.png' | asset }}" alt="">
    <p class="zaxs-kicker" data-hero-kicker>
      <span class="is-on">{{ z_hero_kicker }}</span>
      <span>ستايلك في الشارع</span>
      <span>MADE FOR YOU</span>
    </p>
    <h1><span>{{ z_hero_title|nl2br }}</span></h1>
    <p class="zaxs-lede">{{ z_hero_sub|nl2br }}</p>
    <div class="zaxs-hero__cta">
      <a class="zaxs-btn" href="#fresh">{{ z_hero_cta }}</a>
      <a class="zaxs-btn zaxs-btn--ghost" href="#story">{{ z_hero_cta2 }}</a>
    </div>
  </div>
  <div class="zaxs-hero__dots" data-hero-dots></div>
</section>

<nav class="zaxs-qs zaxs-qs--five" aria-label="تسوق سريع">
  <a class="zaxs-qs__tile" href="#fresh">
    <span>01</span>
    <strong>وصل حديث</strong>
    <em>آخر تصوير</em>
    <small>أربع قطع</small>
  </a>
  <a class="zaxs-qs__tile" href="#hoodies">
    <span>02</span>
    <strong>هودي</strong>
    <em>سبع ألوان</em>
    <small>نفس القصّة</small>
  </a>
  <a class="zaxs-qs__tile" href="#zips">
    <span>03</span>
    <strong>سويت شيرت</strong>
    <em>سوستة كاملة</em>
    <small>من فوق لتحت</small>
  </a>
  <a class="zaxs-qs__tile" href="#pants">
    <span>04</span>
    <strong>بنطلون</strong>
    <em>نفس الطقم</em>
    <small>خمسة ألوان</small>
  </a>
  <a class="zaxs-qs__tile" href="#half">
    <span>05</span>
    <strong>نص سوستة</strong>
    <em>ياقة قصيرة</em>
    <small>أربعة ألوان</small>
  </a>
</nav>

