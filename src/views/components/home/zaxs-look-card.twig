<article class="zaxs-look__card is-shop">
  <div class="zaxs-look__media">
    <a class="zaxs-look__hit" data-zaxs-shop href="{{ href|default(shop) }}">
      <img class="zaxs-look__front" src="{{ img }}" alt="{{ name }}" width="900" height="1200" loading="lazy">
      <img class="zaxs-look__back" src="{{ back|default(img) }}" alt="" width="900" height="1200" loading="lazy">
    </a>
    <span class="zaxs-look__heart" aria-hidden="true">♡</span>
  </div>
  <div class="zaxs-look__quick">
    <p>اختر المقاس</p>
    <div class="zaxs-sizes" role="group" aria-label="المقاس">
      <span>XXL</span>
      <span>XL</span>
      <span>L</span>
      <span>M</span>
      <span>S</span>
    </div>
    <a class="zaxs-look__add" data-zaxs-shop href="{{ href|default(shop) }}">أضف للسلة</a>
  </div>
  <a class="zaxs-look__meta" data-zaxs-shop href="{{ href|default(shop) }}">
    <span class="zaxs-look__names">
      <b>{{ title|default(name) }}{% if tone %} {{ tone }}{% endif %}</b>
      {% if en %}<em class="zaxs-look__en">{{ en }}</em>{% endif %}
    </span>
  </a>
</article>
